---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import HowItWorks from "../components/HowItWorks.astro";
import UseCases from "../components/UseCases.astro";
import BuiltToday from "../components/BuiltToday.astro";
import Roadmap from "../components/Roadmap.astro";
import Team from "../components/Team.astro";
import FAQ from "../components/FAQ.astro";
import PilotCTA from "../components/PilotCTA.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="Flyventory | Drone inventory checks for warehouses"
  description="Flyventory drones scan barcodes and QR codes across your staging area and racks, check what's there against what should be, and log the results. No ladders, no forklifts."
>
  <Header overlay />
  <main id="main">
    <Hero />
    <Problem />
    <HowItWorks />
    <UseCases />
    <BuiltToday />
    <Roadmap />
    <Team />
    <FAQ />
    <PilotCTA />
  </main>
  <Footer />
</Base>
