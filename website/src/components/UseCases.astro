---
import { Picture } from "astro:assets";
import staging from "../../public/media/stock/usecase-staging.webp";

const stagingChecks = [
  { term: "SKU", desc: "wrong products received" },
  { term: "Labels", desc: "missing or incorrect labels" },
  { term: "Records", desc: "physical stock vs. what your system says" },
];

const putAway = [
  "Empty location checks",
  "Item and location verification",
  "Finding a specific SKU or package",
];
---

<!-- Full-bleed split: warehouse aisle photo runs to the left edge on desktop (licensed stock, see docs/stock-credits.md). -->
<section id="use-cases" class="bg-white lg:grid lg:grid-cols-2" aria-labelledby="use-cases-title">
  <figure class="img-reveal relative aspect-[4/3] overflow-hidden bg-light lg:aspect-auto lg:min-h-full">
    <Picture
      src={staging}
      formats={["avif", "webp"]}
              fallbackFormat="webp"
      widths={[640, 1000, 1600]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      alt="Overhead view of a warehouse aisle: a pallet of goods on the floor between racks, two workers beside a pallet jack."
      class="absolute inset-0 size-full object-cover"
    />
  </figure>

  <div class="usecase-content section-y px-4 md:px-6 lg:pl-14">
    <h2 id="use-cases-title" class="text-h2" data-reveal>Where Flyventory fits.</h2>

    <div class="mt-8 space-y-5 lg:mt-10" data-reveal-stagger>
      <article class="card-hover rounded-panel border border-navy/12 bg-white p-6 shadow-[0_24px_48px_-28px_rgb(24_46_82_/_0.35)] sm:p-8">
        <p class="text-label text-blue">Our first focus</p>
        <h3 class="text-h3 mt-3">Put-away and storage</h3>
        <ul class="mt-5 border-t border-navy/12">
          {
            putAway.map((item) => (
              <li class="flex gap-3 border-b border-navy/12 py-3">
                <svg class="mt-0.5 size-5 shrink-0 text-blue" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path
                    d="M5 10.2l3.2 3.2L15 6.6"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <span class="font-semibold">{item}</span>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="card-hover rounded-panel border border-navy/12 bg-light p-6 sm:p-8">
        <p class="text-label text-slate">Next</p>
        <h3 class="text-h3 mt-3">Staging area</h3>
        <p class="text-body mt-3 text-slate">
          Goods arrive, get unloaded and wait in staging before put-away. That&rsquo;s where receiving errors slip
          through. Flyventory will check:
        </p>
        <dl class="mt-5 border-t border-navy/12">
          {
            stagingChecks.map((c) => (
              <div class="grid gap-1 border-b border-navy/12 py-3 sm:grid-cols-[8rem_1fr] sm:gap-4">
                <dt class="font-semibold">{c.term}</dt>
                <dd class="text-slate">{c.desc}</dd>
              </div>
            ))
          }
        </dl>
      </article>
    </div>
  </div>
</section>

<style>
  /* Right column lines up with the site container's right edge on wide screens. */
  @media (width >= 64rem) {
    .usecase-content {
      padding-right: max(2rem, calc((100vw - 72rem) / 2 + 2rem));
    }
  }
</style>
