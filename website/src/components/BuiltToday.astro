---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

// Hardware from the copy: "Built on a Holybro X500 V2 frame: Pixhawk flight controller running PX4,
// NVIDIA Jetson Orin Nano onboard computer, ELP 16MP camera".
const hardware = [
  { icon: "controller", label: "Flight controller", value: "Pixhawk running PX4" },
  { icon: "computer", label: "Onboard computer", value: "NVIDIA Jetson Orin Nano" },
  { icon: "camera", label: "Camera", value: "ELP 16MP camera" },
];

const software = [
  { text: "Real-time barcode and QR code detection" },
  { text: "Each code checked against your expected stock list" },
  {
    text: "Package condition detection",
    tag: "Prototype",
    note: "A model that flags damaged cartons in test images, not yet validated for real use.",
  },
  { text: "Inventory dashboard with found and missing items" },
];

// What it needs: conditions tested so far and not yet tested.
const tested = ["Indoors, in a university lab", "Stacked cartons", "Normal indoor lighting"];
const notTested = ["Dim areas", "Glare from shrink-wrap", "Labels facing away from the aisle"];

// Drone photo slot. TODO: add our real drone photo as public/media/drone.webp.
// Nothing renders until that file exists.
const dronePhoto = Object.values(
  import.meta.glob<ImageMetadata>("../../public/media/drone.webp", { eager: true, import: "default" }),
)[0];
---

<section id="built" class="on-dark section-y bg-navy text-white" aria-labelledby="built-title">
  <div class="container-x">
    <div class:list={["grid gap-10 lg:grid-cols-12 lg:gap-12", dronePhoto && "lg:items-center"]}>
      <div class={dronePhoto ? "lg:col-span-5" : "lg:col-span-12"}>
        <h2 id="built-title" class="text-h2" data-reveal>Working today.</h2>
      </div>
      {
        dronePhoto && (
          <figure class="img-reveal overflow-hidden rounded-panel lg:col-span-7" data-reveal>
            <Picture
              src={dronePhoto}
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              widths={[640, 1200]}
              sizes="(min-width: 1024px) 640px, 100vw"
              alt="The Flyventory drone"
              class="block h-auto w-full"
            />
          </figure>
        )
      }
    </div>

    <p class="text-label mt-12 text-white/70 lg:mt-14" data-reveal>Built on a Holybro X500 V2 frame</p>
    <ul class="mt-4 grid gap-4 md:grid-cols-3 lg:gap-6" data-reveal-stagger>
      {
        hardware.map((h) => (
          <li class="spec-card rounded-panel border border-white/15 p-6 lg:p-8">
            <svg
              class="size-9 text-white"
              viewBox="0 0 36 36"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              {h.icon === "controller" && (
                <>
                  <circle cx="18" cy="18" r="11" />
                  <circle cx="18" cy="18" r="3.5" />
                  <path d="M18 3v4M18 29v4M3 18h4M29 18h4" />
                  <path d="M18 11.5v3M18 21.5v3M11.5 18h3M21.5 18h3" />
                </>
              )}
              {h.icon === "computer" && (
                <>
                  <rect x="9" y="9" width="18" height="18" rx="2" />
                  <rect x="14" y="14" width="8" height="8" rx="1" />
                  <path d="M14 4v5M18 4v5M22 4v5M14 27v5M18 27v5M22 27v5M4 14h5M4 18h5M4 22h5M27 14h5M27 18h5M27 22h5" />
                </>
              )}
              {h.icon === "camera" && (
                <>
                  <rect x="4" y="10" width="28" height="19" rx="3" />
                  <path d="M12 10l2-4h8l2 4" />
                  <circle cx="18" cy="19.5" r="5.5" />
                  <circle cx="18" cy="19.5" r="2" />
                </>
              )}
            </svg>
            <p class="text-label mt-6 text-white/70">{h.label}</p>
            <p class="text-h3 mt-2 text-white">{h.value}</p>
          </li>
        ))
      }
    </ul>

    <p class="text-label mt-12 text-white/70 lg:mt-14" data-reveal>Software</p>
    <ul class="mt-4 grid gap-x-8 gap-y-4 border-t border-white/15 pt-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {
        software.map((item) => (
          <li class="flex gap-3">
            <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5" />
              <path
                d="M6 10.2l2.6 2.6L14 7.4"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span class="text-pretty">
              {item.text}
              {item.tag && (
                <span class="text-label ml-2 inline-block translate-y-[-1px] rounded-[4px] border border-white/35 px-1.5 py-0.5 align-middle text-[0.75rem]">
                  {item.tag}
                </span>
              )}
              {item.note && <span class="mt-1 block text-sm text-white/70">{item.note}</span>}
            </span>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 flex max-w-2xl items-start gap-3 text-white/80" data-reveal>
      <svg class="mt-0.5 size-5 shrink-0 text-white" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <circle cx="10" cy="10" r="8.25" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M10 9v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        <circle cx="10" cy="6.25" r="1" fill="currentColor"></circle>
      </svg>
      <span class="text-pretty">
        We&rsquo;re publishing results from our lab tests soon. During a pilot, we measure the read rate on your own
        inventory and share it with you.
      </span>
    </p>

    <div class="mt-12 rounded-panel border border-white/15 p-6 sm:p-8 lg:mt-14 lg:p-10" data-reveal>
      <h3 class="text-h3">What it needs</h3>
      <div class="mt-6 grid gap-8 md:grid-cols-2">
        <div>
          <p class="text-label text-white/70">Tested</p>
          <ul class="mt-4 grid gap-3">
            {
              tested.map((item) => (
                <li class="flex gap-3">
                  <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5" />
                    <path
                      d="M6 10.2l2.6 2.6L14 7.4"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="text-label text-white/70">Not tested yet</p>
          <ul class="mt-4 grid gap-3">
            {
              notTested.map((item) => (
                <li class="flex gap-3 text-white/80">
                  <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <circle
                      cx="10"
                      cy="10"
                      r="9"
                      stroke="currentColor"
                      stroke-opacity="0.35"
                      stroke-width="1.5"
                      stroke-dasharray="3 3"
                    />
                  </svg>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <p class="mt-8 border-t border-white/15 pt-6 text-white/80">
        Testing these conditions in a real warehouse is the purpose of the pilot.
      </p>
    </div>
  </div>
</section>

<style>
  .spec-card {
    background-color: color-mix(in oklab, var(--color-white), transparent 95%);
    transition: border-color 180ms ease-out;
  }
  .spec-card:hover {
    border-color: color-mix(in oklab, var(--color-white), transparent 60%);
  }
</style>
