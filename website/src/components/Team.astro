---
// TODO: add roles. A role line, photos and LinkedIn links stay hidden until provided.
const members: { name: string; role?: string }[] = [
  { name: "Dr. Reyad El-Khazali", role: "Faculty advisor" },
  { name: "Omar Yousef" },
  { name: "Nour Abed Alhaq" },
  { name: "Sahlah Adesina" },
  { name: "Maha Alhammadi" },
  { name: "Rahika Roza" },
];
---

<section id="team" class="section-y bg-light" aria-labelledby="team-title">
  <div class="container-x grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-12">
    <div class="lg:col-span-3" data-reveal>
      <img
        src="/brand/flyventory-logo-color.svg"
        alt="Flyventory"
        width="200"
        height="200"
        loading="lazy"
        class="size-[120px] lg:size-[200px]"
      />
    </div>

    <div class="lg:col-span-9">
      <div data-reveal>
        <h2 id="team-title" class="text-h2">The team.</h2>
        <p class="text-body mt-4 text-slate">
          We&rsquo;re a team of Khalifa University engineers building Flyventory through the KUEC Incubator.
        </p>
      </div>

      <ul class="mt-8 grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:gap-6" data-reveal-stagger>
        {
          members.map((m) => (
            <li class="card-hover rounded-panel border border-navy/12 bg-white p-6">
              <p class="font-semibold">{m.name}</p>
              {m.role && <p class="mt-1 text-sm text-slate">{m.role}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
