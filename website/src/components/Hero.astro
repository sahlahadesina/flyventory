---
import { Picture } from "astro:assets";
import detectionFrame from "../../public/media/detection-frameout.png";
import aislePoster from "../../public/media/stock/warehouse-aisle-poster.webp";
---

<section
  id="top"
  class="hero on-dark relative isolate -mt-16 overflow-hidden bg-navy text-white lg:-mt-[72px]"
  aria-labelledby="hero-title"
>
  <!-- Background: stock warehouse aisle (see docs/stock-credits.md). Poster paints first; the video
       loads after the page has loaded, and only on wider screens without reduced motion or data saver. -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <Picture
      src={aislePoster}
      formats={["avif", "webp"]}
              fallbackFormat="webp"
      widths={[640, 1280]}
      sizes="100vw"
      alt=""
      loading="eager"
      pictureAttributes={{ class: "absolute inset-0 block size-full" }}
      class="hero-media size-full object-cover"
    />
    <video
      class="hero-video hero-media absolute inset-0 size-full object-cover"
      data-hero-video
      data-src="/media/stock/warehouse-aisle.mp4"
      poster="/media/stock/warehouse-aisle-poster.webp"
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      tabindex="-1"
    >
    </video>
    <div class="hero-overlay absolute inset-0"></div>
  </div>

  <div class="container-x grid gap-10 pt-28 pb-16 lg:grid-cols-12 lg:gap-x-12 lg:gap-y-12 lg:pt-36 lg:pb-24">
    <div class="lg:col-span-12">
      <p class="hero-in text-label text-white/75" style="--i: 0">Drone inventory checks</p>
      <h1 id="hero-title" class="hero-in text-h1 mt-5 max-w-[17ch] text-white lg:max-w-[22ch]" style="--i: 1">
        Check every pallet without climbing a single rack.
      </h1>
    </div>

    <div class="lg:col-span-5 lg:pt-2">
      <p class="hero-in text-lead text-white/85" style="--i: 2">
        Flyventory is a drone and software system for warehouses. It reads barcodes and QR codes on cartons, checks each
        code against your expected stock list, and marks every item Found or Missing with its shelf location on one
        dashboard.
      </p>
      <div class="hero-in mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap [&>a]:whitespace-nowrap" style="--i: 3">
        <a href="/#contact" class="btn btn-accent">Join the pilot list</a>
        <a href="/#live-scan" class="btn btn-outline-light">See how it works</a>
      </div>
    </div>

    <div class="lg:col-span-7">
      <!-- Our real detection output: the most prominent product image on the page. Capped at its native 640px. -->
      <figure class="hero-card mx-auto w-full max-w-[640px] rounded-panel lg:mr-0 border border-white/15 bg-navy p-3 sm:p-4">
        <figcaption class="flex items-center gap-2 px-1 pb-3 sm:pb-4">
          <span class="size-2 rounded-full bg-blue" aria-hidden="true"></span>
          <span class="text-label text-white/80">Real detection screenshot</span>
        </figcaption>
        <div class="scan-frame relative p-2.5 sm:p-3">
          <span class="corner corner-tl" aria-hidden="true"></span>
          <span class="corner corner-tr" aria-hidden="true"></span>
          <span class="corner corner-bl" aria-hidden="true"></span>
          <span class="corner corner-br" aria-hidden="true"></span>

          <div class="scan-image relative overflow-hidden rounded-[4px] bg-white/5">
            <Picture
              src={detectionFrame}
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              widths={[400, 640]}
              sizes="(min-width: 1024px) 600px, calc(100vw - 64px)"
              alt="Camera frame of stacked cartons. Barcodes and QR codes on the labels are outlined as detected, with their codes read out next to them."
              loading="eager"
              fetchpriority="high"
              class="block h-auto w-full"
            />
            <div class="scan-sweep" aria-hidden="true"><span class="scan-line"></span></div>
          </div>
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  /* Darkens the footage for text contrast; strongest behind the headline. */
  .hero-overlay {
    background-color: color-mix(in oklab, var(--color-navy), transparent 14%);
  }
  @media (width >= 64rem) {
    .hero-overlay {
      background: linear-gradient(
        90deg,
        color-mix(in oklab, var(--color-navy), transparent 6%) 0%,
        color-mix(in oklab, var(--color-navy), transparent 16%) 50%,
        color-mix(in oklab, var(--color-navy), transparent 26%) 100%
      );
    }
  }

  .hero-video {
    opacity: 0;
    transition: opacity 700ms ease-out;
  }
  .hero-video.is-playing {
    opacity: 1;
  }

  .hero-card {
    box-shadow:
      0 1px 0 0 color-mix(in oklab, var(--color-white), transparent 92%) inset,
      0 40px 80px -30px rgb(0 0 0 / 0.55);
  }

  /* Viewfinder corners: 2px white L shapes around the image. */
  .corner {
    position: absolute;
    width: 26px;
    height: 26px;
    border-color: var(--color-white);
    border-style: solid;
    border-width: 0;
  }
  .corner-tl {
    top: 0;
    left: 0;
    border-top-width: 2px;
    border-left-width: 2px;
    --dx: -8px;
    --dy: -8px;
  }
  .corner-tr {
    top: 0;
    right: 0;
    border-top-width: 2px;
    border-right-width: 2px;
    --dx: 8px;
    --dy: -8px;
  }
  .corner-bl {
    bottom: 0;
    left: 0;
    border-bottom-width: 2px;
    border-left-width: 2px;
    --dx: -8px;
    --dy: 8px;
  }
  .corner-br {
    bottom: 0;
    right: 0;
    border-bottom-width: 2px;
    border-right-width: 2px;
    --dx: 8px;
    --dy: 8px;
  }

  /* The sweep layer is the image's full height, so translateY(100%) moves the line top to bottom. */
  .scan-sweep {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
  }
  .scan-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background-color: var(--color-blue);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--color-white), transparent 55%);
  }
  .scan-line::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 40px;
    background: linear-gradient(to bottom, transparent, color-mix(in oklab, var(--color-blue), transparent 72%));
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-card {
      animation: card-in 700ms var(--ease-out-soft) 180ms both;
    }
    .corner {
      animation: corner-settle 650ms var(--ease-out-soft) 620ms both;
    }
    .scan-sweep {
      animation: sweep 1500ms cubic-bezier(0.45, 0, 0.25, 1) 1100ms both;
    }
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes corner-settle {
    from {
      opacity: 0;
      transform: translate(var(--dx), var(--dy));
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes sweep {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    8% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(100%);
    }
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  const allowed = window.matchMedia("(min-width: 48rem) and (prefers-reduced-motion: no-preference)").matches;

  if (video && allowed && !saveData) {
    const start = () => {
      video.addEventListener("playing", () => video.classList.add("is-playing"), { once: true });
      video.src = video.dataset.src ?? "";
      video.play().catch(() => {});
    };
    // Wait for the page to finish loading so the video never competes with the first paint.
    if (document.readyState === "complete") setTimeout(start, 250);
    else window.addEventListener("load", () => setTimeout(start, 250), { once: true });
  }
</script>
