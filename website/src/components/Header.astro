---
interface Props {
  /** Transparent with the white logo while it sits over the navy hero. */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;

const links = [
  { href: "/#how-it-works", label: "How it works" },
  { href: "/#use-cases", label: "Use cases" },
  { href: "/#roadmap", label: "Roadmap" },
  { href: "/#team", label: "Team" },
  { href: "/#faq", label: "FAQ" },
];
---

<header
  class="site-header sticky top-0 z-50 h-16 lg:h-[72px]"
  data-header
  data-scrolled="false"
  data-overlay={overlay ? "true" : "false"}
>
  <div class="header-bg" aria-hidden="true"></div>

  <div class="header-inner container-x relative flex h-full items-center justify-between gap-6">
    <a href="/#top" class="header-logo -m-1 shrink-0 p-1">
      <span class="logo-wrap relative block h-[36px] w-[170px] lg:h-[40px] lg:w-[188px]">
        <img
          src="/brand/flyventory-logo-horizontal-color.svg"
          alt="Flyventory home"
          width="188"
          height="40"
          class="logo-color absolute inset-0 size-full"
        />
        {
          overlay && (
            <img
              src="/brand/flyventory-logo-horizontal-white.svg"
              alt=""
              width="188"
              height="40"
              class="logo-white absolute inset-0 size-full"
            />
          )
        }
      </span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="nav-link link-slide py-2 text-[0.9375rem] text-navy">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/#contact" class="btn btn-accent btn-sm hidden lg:inline-flex">Join the pilot list</a>
      <button
        type="button"
        class="menu-toggle -mr-2 inline-flex size-11 items-center justify-center rounded-btn text-navy lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-menu-toggle
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path class="bar bar-top" d="M4 7h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          <path class="bar bar-mid" d="M4 12h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          <path class="bar bar-bot" d="M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="menu-panel absolute inset-x-0 top-full lg:hidden" data-menu-panel data-open="false">
    <nav aria-label="Main" class="container-x pt-2 pb-6">
      <ul class="flex flex-col">
        {
          links.map((link) => (
            <li class="border-b border-navy/10">
              <a href={link.href} class="flex min-h-12 items-center text-base font-semibold text-navy">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/#contact" class="btn btn-accent mt-6 w-full">Join the pilot list</a>
    </nav>
  </div>
</header>

<style>
  /* Background layer and content move with transforms only, so nothing below shifts. */
  .header-bg {
    position: absolute;
    inset: 0;
    background-color: var(--color-white);
    border-bottom: 1px solid transparent;
    transition:
      transform 200ms var(--ease-out-soft),
      opacity 250ms ease-out,
      border-color 200ms ease-out;
  }
  .header-inner,
  .logo-wrap {
    transition: transform 200ms var(--ease-out-soft);
  }
  .logo-wrap {
    transform-origin: left center;
  }
  .logo-color,
  .logo-white {
    transition: opacity 250ms ease-out;
  }
  .logo-white {
    opacity: 0;
  }
  .nav-link,
  .menu-toggle {
    transition: color 250ms ease-out;
  }

  /* Over the navy hero: transparent bar, white logo and links. */
  .site-header[data-overlay="true"]:not([data-scrolled="true"]):not(:has([data-open="true"])) .header-bg {
    opacity: 0;
  }
  .site-header[data-overlay="true"]:not([data-scrolled="true"]):not(:has([data-open="true"])) .logo-color {
    opacity: 0;
  }
  .site-header[data-overlay="true"]:not([data-scrolled="true"]):not(:has([data-open="true"])) .logo-white {
    opacity: 1;
  }
  .site-header[data-overlay="true"]:not([data-scrolled="true"]):not(:has([data-open="true"])) .nav-link,
  .site-header[data-overlay="true"]:not([data-scrolled="true"]):not(:has([data-open="true"])) .menu-toggle {
    color: var(--color-white);
  }
  .site-header[data-overlay="true"]:not([data-scrolled="true"]):not(:has([data-open="true"])) :focus-visible {
    outline-color: var(--color-white);
  }
  .site-header[data-scrolled="true"] .logo-white,
  .site-header:has([data-open="true"]) .logo-white {
    opacity: 0;
  }

  .site-header[data-scrolled="true"] .header-bg {
    transform: translateY(-8px);
    border-bottom-color: color-mix(in oklab, var(--color-navy), transparent 88%);
  }
  .site-header[data-scrolled="true"] .header-inner {
    transform: translateY(-4px);
  }
  .site-header[data-scrolled="true"] .logo-wrap {
    transform: scale(0.92); /* never below the 140px brand minimum */
  }

  /* When the menu is open the bar stays full height and gets a hairline. */
  .site-header:has([data-open="true"]) .header-bg {
    transform: none;
    border-bottom-color: color-mix(in oklab, var(--color-navy), transparent 88%);
  }
  .site-header:has([data-open="true"]) .header-inner {
    transform: none;
  }

  .menu-panel {
    background-color: var(--color-white);
    border-bottom: 1px solid color-mix(in oklab, var(--color-navy), transparent 88%);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition:
      opacity 180ms ease-out,
      transform 200ms var(--ease-out-soft),
      visibility 0s linear 200ms;
  }
  .menu-panel[data-open="true"] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 180ms ease-out,
      transform 200ms var(--ease-out-soft),
      visibility 0s;
  }

  .bar {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 200ms var(--ease-out-soft),
      opacity 150ms ease-out;
  }
  [aria-expanded="true"] .bar-top {
    transform: translateY(5px) rotate(45deg);
  }
  [aria-expanded="true"] .bar-mid {
    opacity: 0;
  }
  [aria-expanded="true"] .bar-bot {
    transform: translateY(-5px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .header-bg,
    .header-inner,
    .logo-wrap,
    .logo-color,
    .logo-white,
    .nav-link,
    .menu-toggle,
    .menu-panel,
    .bar {
      transition: none;
    }
  }
</style>
